generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id
  name             String
  email            String           @unique
  phone            String?
  password         String
  roles            String           @default("customer")
  createdAt        DateTime

  workerProfile    WorkerProfile?
  customerProfile  CustomerProfile?
  customerBookings Booking[]        @relation("CustomerBookings")
}

model WorkerProfile {
  id           String         @id
  userId       String         @unique
  bio          String?
  location     String?
  experience   Int            @default(1)
  wage         Float          @default(500)
  rating       Float          @default(5)
  ratingCount  Int            @default(0)
  createdAt    DateTime

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       WorkerSkill[]
  bookings     Booking[]      @relation("WorkerBookings")

  @@index([userId])
}

model CustomerProfile {
  id          String   @id
  userId      String   @unique
  address     String?
  location    String?
  phone       String?
  createdAt   DateTime

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkerSkill {
  id          String        @id
  workerId    String
  skillName   String

  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, skillName])
  @@index([skillName])
}

model Booking {
  id             String        @id
  customerId     String
  workerId       String
  skillName      String?
  status         String        @default("Pending")
  paymentMode    String?
  paymentStatus  String        @default("Unpaid")
  rating         Int?
  review         String?
  createdAt      DateTime
  updatedAt      DateTime

  customer       User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  worker         WorkerProfile @relation("WorkerBookings", fields: [workerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([workerId])
}
